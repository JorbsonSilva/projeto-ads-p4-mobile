# ====================================================================
# CONFIGURAÇÃO DE AMBIENTE - ORIENTA MOBILE / WEB (P4)
# ====================================================================

# Opções de URL:
# 1) Para execução no Navegador (Web) ou Emulador Android com 'adb reverse':
EXPO_PUBLIC_API_URL=http://localhost:8080

# 2) Para teste em Smartphone físico com Expo Go (substitua pelo IP do seu PC na rede Wi-Fi):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8080

# 3) Para demonstração em nuvem (Render / HTTPS):
# EXPO_PUBLIC_API_URL=https://orienta-api.onrender.com
